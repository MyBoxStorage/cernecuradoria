# =============================================================================
# Cerne Curadoria — variáveis de ambiente
# =============================================================================
# Uso local:  copie este arquivo para `.env.local` e preencha.
#             cp .env.example .env.local
#
# Uso Vercel: Project → Settings → Environment Variables
#             Cadastre CADA chave abaixo (mesmos nomes).
#             Marque Production + Preview (+ Development se quiser).
#             Variáveis NEXT_PUBLIC_* ficam expostas no browser — não coloque
#             segredos nelas. RESEND_API_KEY é secreta (só server).
#
# Depois de alterar na Vercel: redeploy para aplicar.
# =============================================================================

# -----------------------------------------------------------------------------
# Site (obrigatória em produção)
# -----------------------------------------------------------------------------
# URL canônica sem barra no final.
# Enquanto não tiver .com.br: https://SEU-PROJETO.vercel.app
# Com domínio final:          https://cernecuradoria.com.br
NEXT_PUBLIC_SITE_URL=https://SEU-PROJETO.vercel.app

# -----------------------------------------------------------------------------
# Google Analytics 4 (opcional até ativar analytics)
# -----------------------------------------------------------------------------
# GA4 → Admin → Data streams → Web → Measurement ID
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Google Search Console (opcional até verificar propriedade)
# -----------------------------------------------------------------------------
# Search Console → Configurações → Verificação de propriedade → Meta tag
# Cole SÓ o valor do content= (não a tag HTML inteira)
# Ex.: content="abc123..." → use abc123...
NEXT_PUBLIC_GSC_VERIFICATION=COLE_O_CODIGO_DE_VERIFICACAO_AQUI

# -----------------------------------------------------------------------------
# Resend — formulário de Contato (obrigatórias para o lead funcionar)
# -----------------------------------------------------------------------------
# Resend → API Keys → Create API Key
# Formato típico: re_xxxxxxxx
RESEND_API_KEY=re_COLE_A_CHAVE_AQUI

# Remetente. Sem domínio verificado no Resend, deixe o teste oficial:
CONTACT_EMAIL_FROM=onboarding@resend.dev
# Depois de verificar cernecuradoria.com.br no Resend, troque para algo como:
# CONTACT_EMAIL_FROM=contato@cernecuradoria.com.br

# Destino dos leads (caixa que recebe as mensagens do formulário)
CONTACT_EMAIL_TO=seu-email@exemplo.com
